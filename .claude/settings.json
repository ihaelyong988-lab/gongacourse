{
  "_주석": "훅 3종 범용판. <검증명령>·라우팅 문구를 새 프로젝트에 맞게 수정. 코드 프로젝트가 아니면 PostToolUse/Stop 검증을 빼거나 lint/test로 교체.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "node scripts/harness-context.mjs" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "node scripts/validate.mjs" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node scripts/validate.mjs" }
        ]
      }
    ]
  }
}
